# Mesma string de conexão do Atlas usada pela API.
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=faelchess
# Caminho do binário do Stockfish (no Windows, algo como C:\stockfish\stockfish-windows-x86-64-avx2.exe).
STOCKFISH_PATH=stockfish
# Profundidade e número de linhas por posição. No PC de casa, 16-18 é tranquilo.
ANALYSIS_DEPTH=16
ANALYSIS_MULTIPV=3
STOCKFISH_THREADS=2
STOCKFISH_HASH_MB=256
# Intervalo de polling quando a fila está vazia, e quando um job "processing" é considerado travado.
POLL_MS=5000
STUCK_MINUTES=10
