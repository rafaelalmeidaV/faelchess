# String de conexão do MongoDB Atlas (Database > Connect > Drivers).
MONGODB_URI=mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=faelchess
PORT=3000
# Opcional: se definido, todas as rotas REST (exceto as do online por token) exigem o header x-access-key.
ACCESS_KEY=
# Origem do front permitida no CORS (em produção o Caddy serve tudo no mesmo domínio, então pode ficar vazio).
CORS_ORIGIN=http://localhost:5173
