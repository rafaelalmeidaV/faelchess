{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "styled-system/*": [
        "./styled-system/*"
      ],
      "@faelchess/shared": [
        "../../packages/shared/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "styled-system"
  ]
}
