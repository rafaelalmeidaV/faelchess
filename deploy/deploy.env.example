# Copie para deploy/deploy.env (ignorado pelo git) e ajuste. Usado por deploy-vm.sh, deploy-worker.sh e set-db-password.sh.

# VM que roda API + front + Caddy: apelido do ~/.ssh/config ou usuario@ip.
VM_HOST=minha-vm
# Domínio público (o Caddy tira o certificado HTTPS sozinho).
DOMAIN=chess.seudominio.com
# Máquina que roda o worker de análise (Stockfish).
WORKER_HOST=usuario@192.168.0.10
